# Application
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nerd_back_db

# JWT
JWT_ACCESS_SECRET=super_secret_access_key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_key
JWT_REFRESH_EXPIRATION=7d
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY----------END RSA PRIVATE KEY-----"

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBANRo3GRPI3wXiuAhhygmndlT+cRmW98Li9J1K9aZiCc+B6pO+cMAVDFwoWtV1+M11HxWnprwLdeak5s+XIY068UCAwEAAQ==-----END PUBLIC KEY-----"


# Logging
LOG_LEVEL=debug

# Recommended for most uses
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nerd_back_db

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/nerd_back_db
